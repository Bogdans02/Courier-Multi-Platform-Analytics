{
  "name": "courstat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:sync:emulator": "npm run build -- --mode android-emulator && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android --no-sync",
    "android:run:emulator": "npm run android:sync:emulator && cap run android --no-sync"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "chart.js": "^4.5.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  }
}

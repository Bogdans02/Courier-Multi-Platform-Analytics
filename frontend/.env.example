VITE_API_BASE_URL=http://localhost:3000/api
# Windows browser and Android USB with adb reverse use the URL above.
# npm run android:sync:emulator loads .env.android-emulator instead (10.0.2.2).
# Mode-specific files override .env; an existing shell variable overrides both.
# This value is embedded at build time; rebuild and sync after changing it.
# Release builds require an HTTPS backend URL.

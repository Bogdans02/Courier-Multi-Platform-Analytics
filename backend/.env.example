PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Required: generate a random secret (at least 32 characters); do not commit the real value.
JWT_SECRET=
# PostgreSQL 16+; create the database first and replace these example credentials.
DATABASE_URL=postgresql://courier_user:replace_me@localhost:5432/courier_analytics
# Optional, dedicated test database. Do not point this at production.
TEST_DATABASE_URL=postgresql://courier_user:replace_me@localhost:5432/courier_analytics_test
